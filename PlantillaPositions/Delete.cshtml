@model SIETE.Models.PlantillaPosition

@{
    ViewData["Title"] = "Delete Position";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Delete Position</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="alert alert-warning" role="alert">
                <h4 class="alert-heading">Warning!</h4>
                <p>Are you sure you want to delete this position? This action cannot be undone.</p>
            </div>

            <dl class="row">
                <dt class="col-sm-3">Position Title</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.PositionTitle)</dd>
            </dl>
            
            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="PositionID" />
                <div class="btn-group" role="group">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>Delete
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-times-circle me-1"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
