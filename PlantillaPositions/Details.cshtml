@model SIETE.Models.PlantillaPosition

@{
    ViewData["Title"] = "Position Details";
}

<div class="position-details">
    <!-- Position Header -->
    <div class="position-header mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="position-icon">
                <i class="fas fa-user-tie fa-2x text-primary"></i>
            </div>
            <div>
                <h4 class="mb-1">@Model.PositionTitle</h4>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Position Information -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Position Information</h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-12">
                    <div class="info-item">
                        <label class="text-muted small">Status</label>
                        <p class="mb-0">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">
                                    <i class="fas fa-circle me-1" style="font-size: 0.5rem;"></i>Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger">
                                    <i class="fas fa-circle me-1" style="font-size: 0.5rem;"></i>Inactive
                                </span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Associated Employees -->
    @if (Model.Employees != null && Model.Employees.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h6 class="mb-0"><i class="fas fa-users me-2"></i>Associated Employees</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th class="fw-semibold">Employee Name</th>
                                <th class="fw-semibold">Office</th>
                                <th class="fw-semibold text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var employee in Model.Employees)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-user text-primary me-2"></i>
                                            @employee.FullName
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-building text-secondary me-2"></i>
                                            @employee.Office?.OfficeName
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary"
                                                onclick="openGlobalModal('Employee Details', '/Employees/Details/@employee.EmployeeID', 'fas fa-eye')"
                                                data-bs-toggle="tooltip" title="View Employee Details">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-4">
            <i class="fas fa-users fa-3x text-muted mb-3"></i>
            <p class="text-muted mb-0">No employees are currently associated with this position.</p>
        </div>
    }
</div>

<style>
    .badge {
        padding: 0.5em 0.75em;
        font-weight: 500;
        border-radius: 0.5rem;
    }

    .bg-success-subtle {
        background-color: #e6f4ea;
    }

    .text-success {
        color: #137333 !important;
    }

    .bg-danger-subtle {
        background-color: #fce8e6;
    }

    .text-danger {
        color: #c5221f !important;
    }

    .text-accent {
        color: #FFD700 !important;
    }

    .card {
        border: none;
        border-radius: 0.5rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #e9ecef;
        padding: 1rem;
    }

    .card-body {
        padding: 1.5rem;
    }

    .info-item {
        margin-bottom: 1rem;
    }

    .info-item label {
        display: block;
        margin-bottom: 0.25rem;
    }

    .info-item p {
        font-weight: 500;
    }

    .table th {
        font-weight: 600;
        color: #495057;
    }

    .btn-outline-primary {
        color: #4e73df;
        border-color: #4e73df;
    }

    .btn-outline-primary:hover {
        color: #fff;
        background-color: #4e73df;
        border-color: #4e73df;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });
        });
    </script>
}

