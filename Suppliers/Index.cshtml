@model IEnumerable<SIETE.Models.Supplier>

@{
    ViewData["Title"] = "Supplier Management";
}

<div class="container py-4">
    <!-- Page Header -->
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">📦 Supplier Management</h2>
        <p class="text-muted mb-0">Easily manage your list of suppliers, or view details.</p>
    </div>

    <!-- Action Button -->
    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-success"
                onclick="openGlobalModal('Add New Supplier', '/Suppliers/Create', 'fas fa-plus-circle')"
                data-bs-toggle="tooltip" data-bs-placement="left" title="Create a new supplier">
            <i class="fas fa-plus-circle me-1"></i> Add Supplier
        </button>
    </div>

    <!-- Data Table -->
    <div class="table-responsive shadow-sm border rounded">
        <table id="dataTable" class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-primary text-center">
                <tr>
                    <th>Supplier Name</th>
                    <th>TIN</th>
                    <th style="width: 160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.SupplierName</td>
                        <td>@item.TIN</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary"
                                    onclick="openGlobalModal('Supplier Details', '/Suppliers/Details/@item.SupplierID', 'fas fa-eye')"
                                    data-bs-toggle="tooltip" title="View full details">
                                <i class="fas fa-eye"></i>
                            </button>

                            <button class="btn btn-sm btn-outline-warning"
                                    onclick="openGlobalModal('Update Supplier Details', '/Suppliers/Edit/@item.SupplierID', 'fas fa-pen')"
                                    data-bs-toggle="tooltip" title="Update">
                                <i class="fas fa-pen"></i>
                            </button>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <p class="text-muted">No suppliers found. Click "Add Supplier" to get started.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                responsive: true,
                fixedHeader: true,
                pageLength: 10,
                language: {
                    search: "🔍 Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ suppliers",
                    emptyTable: "No supplier data available."
                }
            });

            // Enable Bootstrap tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });
        });

        
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}
