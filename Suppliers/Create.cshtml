@model SIETE.Models.Supplier

<form asp-action="Create" id="supplierForm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="SupplierName" class="form-label fw-bold">Supplier Name</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-building"></i></span>
                <input asp-for="SupplierName" class="form-control" placeholder="Enter supplier name" required />
            </div>
            <span asp-validation-for="SupplierName" class="text-danger small"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="Date" class="form-label fw-bold">Registration Date</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-calendar"></i></span>
                <input asp-for="Date" class="form-control" type="date" required />
            </div>
            <span asp-validation-for="Date" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label fw-bold">Business Address</label>
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
            <input asp-for="Address" class="form-control" placeholder="Enter complete address" required />
        </div>
        <span asp-validation-for="Address" class="text-danger small"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="ContactNo" class="form-label fw-bold">Contact Number</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-phone"></i></span>
                <input asp-for="ContactNo" class="form-control" placeholder="Enter contact number" required />
            </div>
            <span asp-validation-for="ContactNo" class="text-danger small"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="IsVatRegistered" class="form-label fw-bold">VAT Status</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-receipt"></i></span>
                <select asp-for="IsVatRegistered" class="form-select" required>
                    <option value="" disabled selected>-- Select VAT Status --</option>
                    <option value="true">VAT Registered</option>
                    <option value="false">Non-VAT Registered</option>
                </select>
            </div>
            <span asp-validation-for="IsVatRegistered" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-4">
        <label asp-for="TIN" class="form-label fw-bold">TIN</label>
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-id-card"></i></span>
            <input asp-for="TIN" class="form-control" placeholder="Enter TIN (format: XXX-XXX-XXX)" required />
        </div>
        <small class="form-text text-muted">TIN format example: 123-456-789</small>
        <span asp-validation-for="TIN" class="text-danger small"></span>
    </div>

    <div class="modal-footer border-top pt-3">
        <button type="reset" class="btn btn-outline-secondary">
            <i class="fas fa-undo"></i> Reset
        </button>
        <button type="submit" class="btn btn-success">
            <i class="fas fa-save"></i> Save
        </button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
