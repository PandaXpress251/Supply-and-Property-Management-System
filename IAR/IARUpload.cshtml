@model SIETE.Models.Supply.SupplyTransactionVM
@{
    ViewData["Title"] = "IAR Upload";
}

<h2 id="excelImportHeader">IAR Upload</h2>

<div class="card-body">
    <div class="row g-2">
        <div class="col-md-4">
            <label for="excelFile" class="form-label fw-bold">Step 1: Upload Excel File</label>
            <input type="file" id="excelFile" class="form-control" accept=".xlsx, .xls" />
            <small class="text-muted">Accepted formats: .xlsx, .xls</small>
        </div>

        <div class="col-md-4">
            <label for="fundClusterSelectExcel" class="form-label fw-bold">Step 2: Select Fund Cluster</label>
            <select id="fundClusterSelectExcel" class="form-select" asp-items="Model.FundClusterList" required>
                <option value="">- Select Fund Cluster -</option>
            </select>
        </div>

        <div class="col-md-4">
            <label for="supplierSelectExcel" class="form-label fw-bold">Step 3: Select Supplier</label>
            <select id="supplierSelectExcel" class="form-select" asp-items="Model.SupplierList" required>
                <option value="">- Select Supplier -</option>
            </select>
        </div>
    </div>

    <div class="mt-4">
        <button class="btn btn-primary w-100" onclick="extractData()">Extract & Preview Data</button>
        <div id="loadingIndicator" class="mt-2 text-muted" style="display: none;">Extracting data... <i class="fas fa-spinner fa-spin"></i></div>
    </div>

    <h5 class="fw-bold mt-4">Step 4: Review the Imported Data Before Saving</h5>

    <div class="table-responsive" style="max-height: 450px; overflow-y: auto;">
        <table class="table table-bordered mt-3" id="excelDataTable" style="display: none;">
            <thead class="table-dark" style="position: sticky; top: 0; z-index: 2;">
                <tr>
                    <th>Stock/Property No</th>
                    <th>Unit</th>
                    <th>Supply Name</th>
                    <th>Description</th>
                    <th>Quantity</th>
                    <th>Unit Cost</th>
                    <th>Category (Editable)</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

        <button id="saveExcelBtn" onclick="saveSupplyTransactionOnly()" class="btn btn-success">
            Save Transaction
        </button>
    </div>
</div>

@section Scripts {
    <script src="~/js/IARscan.js"></script>
}
