@model SIETE.Models.Office

@{
    ViewData["Title"] = "Delete Office";
    Layout = null;
}

<form asp-action="Delete" id="deleteForm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="OfficeID" />
    
    <div class="alert alert-warning mb-4">
        <i class="fas fa-exclamation-triangle me-2"></i>
        Are you sure you want to delete this office?
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="OfficeName" class="form-control" readonly />
                <label asp-for="OfficeName" class="form-label">Office Name</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="Acronym" class="form-control" readonly />
                <label asp-for="Acronym" class="form-label">Acronym</label>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="OfficeType" class="form-control" readonly />
                <label asp-for="OfficeType" class="form-label">Office Type</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="RespCenter_Code" class="form-control" readonly />
                <label asp-for="RespCenter_Code" class="form-label">Responsibility Center Code</label>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="Parent_Code" class="form-control" readonly />
                <label asp-for="Parent_Code" class="form-label">Parent Code</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-check form-switch mt-4">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" disabled />
                <label class="form-check-label">Active Status</label>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-danger">
            <i class="fas fa-trash me-2"></i>Delete Office
        </button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
    }

    .form-floating > .form-control,
    .form-floating > .form-select {
        height: calc(3.5rem + 2px);
        line-height: 1.25;
    }

    .form-floating > label {
        padding: 1rem 0.75rem;
    }
</style>
