@model IEnumerable<SIETE.Models.Property.PropertyTransaction>

@{
    ViewData["Title"] = "Property Transactions";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">🏷️ Property Transactions Index</h2>
    </div>


    <div class="table-responsive">
        <table id="dataTable" class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.First().Type)</th>
                    <th>@Html.DisplayNameFor(model => model.First().TransactionDate)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Remarks)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Enum.GetName(typeof(SIETE.Models.Property.TransactionTypes), item.Type)</td>
                        <td>@item.TransactionDate.ToString("MMMM dd, yyyy")</td>
                        <td>@item.Remarks</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"
                                    onclick="openGlobalModal('Supplier Details', '/PropertyTransactions/Details/@item.TransactionID', 'fas fa-eye')"
                                    data-bs-toggle="tooltip" title="View full details">
                                <i class="fas fa-eye"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('#dataTable').DataTable({
                responsive: true,
                fixedHeader: true,
                pageLength: 10,
                language: {
                    search: "🔍 Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ stock items",
                    emptyTable: "No stock data available."
                }
            });

            // Enable Bootstrap tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
        });
    </script>
}
