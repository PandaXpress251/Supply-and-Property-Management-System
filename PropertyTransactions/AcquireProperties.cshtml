@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model SIETE.Models.Property.PropertyTransactionVM
@{
    ViewData["Title"] = "Acquire Properties";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">
                        + Acquire Properties
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Warning Alert -->
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <h4 class="alert-heading">⚠️ Important Notice!</h4>
                        <p class="mb-0">Please review all information carefully before submitting. <strong>Property acquisition transactions cannot be edited after submission.</strong></p>
                        <hr>
                        <p class="mb-0">Make sure all details are accurate, including:</p>
                        <ul class="mb-0">
                            <li>Property names and descriptions</li>
                            <li>Quantities and unit costs</li>
                            <li>Supplier and fund cluster selections</li>
                            <li>Stock property numbers</li>
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>

                    <form asp-action="AcquireProperties" method="post" id="propertyForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Transaction Details -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">
                                    ℹ️ Transaction Details
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Transaction.TransactionDate" class="control-label fw-bold">
                                                📅 Transaction Date <span class="text-danger">*</span>
                                            </label>
                                            <input asp-for="Transaction.TransactionDate" class="form-control" type="datetime-local" required />
                                            <span asp-validation-for="Transaction.TransactionDate" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Transaction.Remarks" class="control-label fw-bold">
                                                💬 Remarks
                                            </label>
                                            <textarea asp-for="Transaction.Remarks" class="form-control" rows="1" 
                                                      placeholder="Enter any additional notes about this acquisition..."></textarea>
                                            <span asp-validation-for="Transaction.Remarks" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Property Details -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">
                                    📦 Property Details
                                </h5>
                            </div>
                            <div class="card-body">
                                <div id="propertyDetails">
                                    @for (var i = 0; i < Model.PropertyTransactionDetail.Count; i++)
                                    {
                                        <div class="property-item border rounded p-3 mb-3 bg-light">
                                            <div class="row">
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label class="control-label fw-bold">
                                                            📝 Property Name <span class="text-danger">*</span>
                                                        </label>
                                                        <input asp-for="PropertyTransactionDetail[i].Property.PropertyName" class="form-control" required 
                                                               placeholder="Enter property name"/>
                                                        <span asp-validation-for="PropertyTransactionDetail[i].Property.PropertyName" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label class="control-label fw-bold">
                                                            📄 Description
                                                        </label>
                                                        <input asp-for="PropertyTransactionDetail[i].Property.Description" class="form-control" 
                                                               placeholder="Enter property description"/>
                                                        <span asp-validation-for="PropertyTransactionDetail[i].Property.Description" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-md-2">
                                                    <div class="form-group">
                                                        <label class="control-label fw-bold">
                                                            📏 Unit. <span class="text-danger">*</span>
                                                        </label>
                                                        <input asp-for="PropertyTransactionDetail[i].Property.UnitMeasurement" class="form-control" required 
                                                               placeholder="e.g., pcs, kg, etc."/>
                                                        <span asp-validation-for="PropertyTransactionDetail[i].Property.UnitMeasurement" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-md-2">
                                                    <div class="form-group">
                                                        <label class="control-label fw-bold">
                                                            🔢 Quantity <span class="text-danger">*</span>
                                                        </label>
                                                        <input asp-for="PropertyTransactionDetail[i].Quantity" class="form-control property-quantity" 
                                                               type="number" min="1" required />
                                                        <span asp-validation-for="PropertyTransactionDetail[i].Quantity" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-md-2">
                                                    <div class="form-group">
                                                        <label class="control-label fw-bold">
                                                            💰 Unit Cost <span class="text-danger">*</span>
                                                        </label>
                                                        <div class="input-group">
                                                            <span class="input-group-text">₱</span>
                                                            <input asp-for="PropertyTransactionDetail[i].UnitCost" class="form-control property-cost" 
                                                                   type="number" step="0.01" min="0" required />
                                                        </div>
                                                        <span asp-validation-for="PropertyTransactionDetail[i].UnitCost" class="text-danger"></span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row mt-3">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label class="control-label fw-bold">
                                                            🚚 Supplier <span class="text-danger">*</span>
                                                        </label>
                                                        <select asp-for="PropertyTransactionDetail[i].Property.SupplierID" class="form-select" asp-items="Model.SupplierList" required>
                                                            <option value="">-- Select Supplier --</option>
                                                        </select>
                                                        <span asp-validation-for="PropertyTransactionDetail[i].Property.SupplierID" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label class="control-label fw-bold">
                                                            💵 Fund Cluster <span class="text-danger">*</span>
                                                        </label>
                                                        <select asp-for="PropertyTransactionDetail[i].Property.FundClusterID" class="form-select" asp-items="Model.FundClusterList" required>
                                                            <option value="">-- Select Fund Cluster --</option>
                                                        </select>
                                                        <span asp-validation-for="PropertyTransactionDetail[i].Property.FundClusterID" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label class="control-label fw-bold">
                                                            🏷️ Stock Property No. <span class="text-danger">*</span>
                                                        </label>
                                                        <input asp-for="PropertyTransactionDetail[i].Property.StockPropNo" class="form-control" required 
                                                               placeholder="Enter stock property number"/>
                                                        <span asp-validation-for="PropertyTransactionDetail[i].Property.StockPropNo" class="text-danger"></span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row mt-3">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label class="control-label fw-bold">
                                                            🧮 Total Amount
                                                        </label>
                                                        <input type="text" class="form-control property-total" readonly />
                                                    </div>
                                                </div>
                                                <div class="col-md-6 text-end">
                                                    @if (i > 0)
                                                    {
                                                        <button type="button" class="btn btn-danger btn-sm remove-property">
                                                            🗑️ Remove Property
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="text-center mt-3">
                                    <button type="button" class="btn btn-success" id="addProperty">
                                        ➕ Add Another Property
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Summary Card -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">
                                    📊 Transaction Summary
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h5>📦 Total Items: <span id="totalItems" class="text-primary">0</span></h5>
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <h5>💰 Total Amount: <span id="totalAmount" class="text-primary">₱0.00</span></h5>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="form-group text-end">
                                    <a asp-action="Index" class="btn btn-secondary me-2">
                                        ⬅️ Back to List
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        💾 Save Transaction
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function updateTotals() {
            let totalItems = 0;
            let totalAmount = 0;
            $(".property-item").each(function () {
                let qty = parseFloat($(this).find(".property-quantity").val()) || 0;
                let cost = parseFloat($(this).find(".property-cost").val()) || 0;
                let itemTotal = qty * cost;
                $(this).find(".property-total").val(itemTotal.toLocaleString('en-PH', { style: 'currency', currency: 'PHP' }));
                totalItems += qty;
                totalAmount += itemTotal;
            });
            $("#totalItems").text(totalItems);
            $("#totalAmount").text(totalAmount.toLocaleString('en-PH', { style: 'currency', currency: 'PHP' }));
        }

        $(document).ready(function () {
            updateTotals();

            // Add new property
            $("#addProperty").click(function () {
                var index = $(".property-item").length;
                var template = `
                    <div class="property-item border rounded p-3 mb-3 bg-light">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="control-label fw-bold">
                                        📝 Property Name <span class="text-danger">*</span>
                                    </label>
                                    <input name="PropertyTransactionDetail[${index}].Property.PropertyName" class="form-control" required 
                                           placeholder="Enter property name"/>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="control-label fw-bold">
                                        📄 Description
                                    </label>
                                    <input name="PropertyTransactionDetail[${index}].Property.Description" class="form-control" 
                                           placeholder="Enter property description"/>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label class="control-label fw-bold">
                                        📏 Unit Measurement <span class="text-danger">*</span>
                                    </label>
                                    <input name="PropertyTransactionDetail[${index}].Property.UnitMeasurement" class="form-control" required 
                                           placeholder="e.g., pcs, kg, etc."/>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label class="control-label fw-bold">
                                        🔢 Quantity <span class="text-danger">*</span>
                                    </label>
                                    <input name="PropertyTransactionDetail[${index}].Quantity" class="form-control property-quantity" 
                                           type="number" min="1" required />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label class="control-label fw-bold">
                                        💰 Unit Cost <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">₱</span>
                                        <input name="PropertyTransactionDetail[${index}].UnitCost" class="form-control property-cost" 
                                               type="number" step="0.01" min="0" required />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="control-label fw-bold">
                                        🚚 Supplier <span class="text-danger">*</span>
                                    </label>
                                    <select name="PropertyTransactionDetail[${index}].Property.SupplierID" class="form-select" required>
                                        <option value="">-- Select Supplier --</option>
                                        @foreach (var item in Model.SupplierList)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="control-label fw-bold">
                                        💵 Fund Cluster <span class="text-danger">*</span>
                                    </label>
                                    <select name="PropertyTransactionDetail[${index}].Property.FundClusterID" class="form-select" required>
                                        <option value="">-- Select Fund Cluster --</option>
                                        @foreach (var item in Model.FundClusterList)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="control-label fw-bold">
                                        🏷️ Stock Property No. <span class="text-danger">*</span>
                                    </label>
                                    <input name="PropertyTransactionDetail[${index}].Property.StockPropNo" class="form-control" required 
                                           placeholder="Enter stock property number"/>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="control-label fw-bold">
                                        🧮 Total Amount
                                    </label>
                                    <input type="text" class="form-control property-total" readonly />
                                </div>
                            </div>
                            <div class="col-md-6 text-end">
                                <button type="button" class="btn btn-danger btn-sm remove-property">
                                    🗑️ Remove Property
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                $("#propertyDetails").append(template);
                updateTotals();
            });

            // Remove property
            $(document).on('click', '.remove-property', function () {
                $(this).closest('.property-item').remove();
                updateTotals();
            });

            // Update totals when quantity or cost changes
            $(document).on('input', '.property-quantity, .property-cost', function () {
                updateTotals();
            });

            // Form validation
            $('#propertyForm').on('submit', function(e) {
                if ($('.property-item').length === 0) {
                    e.preventDefault();
                    alert('Please add at least one property to acquire.');
                    return false;
                }

                // Confirm before submission
                if (!confirm('Are you sure you want to submit this acquisition? This action cannot be undone.')) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}

