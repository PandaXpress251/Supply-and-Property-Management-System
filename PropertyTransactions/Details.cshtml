@model SIETE.Models.Property.PropertyTransaction

@{
    ViewData["Title"] = "Transaction Details";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold mb-4">📝 Transaction Details</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary bg-opacity-10">
            <h4 class="card-title mb-0">Transaction Information</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Transaction Type</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.Type == SIETE.Models.Property.TransactionTypes.Aquired ? "bg-success" :
                                        Model.Type == SIETE.Models.Property.TransactionTypes.Transferred ? "bg-info" :
                                        "bg-danger")">
                        @Model.Type
                    </span>
                </dd>

                <dt class="col-sm-3">Transaction Date</dt>
                <dd class="col-sm-9">@Model.TransactionDate.ToString("MMMM dd, yyyy")</dd>

                <dt class="col-sm-3">Remarks</dt>
                <dd class="col-sm-9">@Model.Remarks</dd>
            </dl>
        </div>
    </div>

    @if (Model.PropertyTransactionDetails != null && Model.PropertyTransactionDetails.Any())
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info bg-opacity-10">
                <h4 class="card-title mb-0">Transaction Details</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped">
                        <thead class="table-light">
                            <tr>
                                <th>Property</th>
                                <th>Quantity</th>
                                <th>Unit Cost</th>
                                <th>Total Amount</th>
                                <th>Employee</th>
                                <th>Office</th>
                                <th>Location</th>
                                <th>Disposal Type</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.PropertyTransactionDetails)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Properties"
                                           asp-action="Details"
                                           asp-route-id="@detail.PropertyID"
                                           class="text-decoration-none">
                                            @detail.Property.PropertyName
                                        </a>
                                    </td>
                                    <td>@detail.Quantity</td>
                                    <td>@detail.UnitCost.ToString("C", new System.Globalization.CultureInfo("en-PH"))</td>
                                    <td>@((detail.Quantity * detail.UnitCost).ToString("C", new System.Globalization.CultureInfo("en-PH")))</td>
                                    <td></td>
                                    <td></td>

                                    <td>@detail.Location</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(detail.DisposalType))
                                        {
                                            <span class="badge bg-warning">@detail.DisposalType</span>
                                        }
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-4">

    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>
