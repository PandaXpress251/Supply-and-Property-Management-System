@model IEnumerable<SIETE.Models.FundCluster>

@{
    ViewData["Title"] = "Index";
}

<h1>Fund Clusters</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FundClusterCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FundClusterName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FundClusterCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FundClusterName)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.FundClusterID">Update</a> |

                </td>
            </tr>
        }
    </tbody>
</table>
