@model SIETE.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CSC RO7 SPMS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            position: relative;
            min-height: 100vh;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', sans-serif;
            overflow: hidden;
        }

            body::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                height: 100%;
                width: 100%;
                background: url('/img/CSC Logo.png') no-repeat center center;
                background-size: 700px; /* Smaller logo size */
                opacity: 0.07; /* Subtle and light visibility */
                z-index: -1;
            }

        .login-container {
            background-color: #ffffff;
            padding: 2rem;
            border-radius: 1rem;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            max-width: 400px;
            width: 100%;
            margin-top: 5%;
            opacity: 97%;
        }

        .logo img {
            max-width: 180px;
            height: auto;
            margin-bottom: 1.5rem;
        }

        .login-title {
            font-size: 1.5rem;
            font-weight: bold;
            color: #003865; /* Deep Blue - CSC RO7 color */
            margin-bottom: 1.5rem;
        }

        .form-group label {
            font-weight: 600;
        }

        .form-group input {
            border-radius: 0.375rem;
        }

        .form-group .text-danger {
            font-size: 0.9rem;
        }

        .form-group .form-check-label {
            font-size: 0.9rem;
        }

        .login-btn {
            width: 100%;
            padding: 12px;
            background-color: #8A1538; /* Dark Red - CSC RO7 color */
            color: white;
            border: none;
            border-radius: 0.375rem;
            font-size: 1rem;
            cursor: pointer;
        }

            .login-btn:hover {
                background-color: #5e0f25;
            }
    </style>
</head>
<body>
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 100vh;">
        <div class="login-container">
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="logo text-center">
                    <h2 class="login-title">SIETE Login</h2>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Username" class="form-label">Username</label>
                    <input asp-for="Username" class="form-control" placeholder="Enter your username" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group form-check mb-4">
                    <input asp-for="RememberMe" type="checkbox" class="form-check-input" id="rememberMe" />
                    <label class="form-check-label" for="rememberMe">Remember Me</label>
                </div>

                <button type="submit" class="login-btn">Login</button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>
