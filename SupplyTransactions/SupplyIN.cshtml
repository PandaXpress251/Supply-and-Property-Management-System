@model SIETE.Models.Supply.SupplyTransactionVM

@{
    ViewData["Title"] = "Supply Intake";
}

<div class="container-fluid">
    <h2>Supply Intake</h2>
    <hr />

    <form asp-action="SupplyIN" method="post" id="supplyForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Transaction Details</h4>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="Transaction.Remarks" class="control-label"></label>
                            <textarea asp-for="Transaction.Remarks" class="form-control" rows="1"></textarea>
                            <span asp-validation-for="Transaction.Remarks" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <!-- Left Side: Supply Entry Form -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h4>New Supply Entry</h4>
                    </div>
                    <div class="card-body">
                        <div class="supply-detail-item">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label class="control-label">Supplier</label>
                                        <select id="supplierSelect" class="form-control" asp-items="Model.SupplierList">
                                            <option value="">-- Select Supplier --</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label class="control-label">Fund Cluster</label>
                                        <select id="fundClusterSelect" class="form-control" asp-items="Model.FundClusterList">
                                            <option value="">-- Select Fund Cluster --</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label">Stock Property Number</label>
                                        <input type="text" id="stockPropNo" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label">Supply Name</label>
                                        <input type="text" id="supplyName" class="form-control" />
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label">Description</label>
                                        <input type="text" id="description" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label">Unit Measurement</label>
                                        <input type="text" id="unitMeasurement" class="form-control" />
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label">Quantity</label>
                                        <input type="number" id="quantity" class="form-control" min="1" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label">Unit Cost</label>
                                        <input type="number" id="unitCost" class="form-control" min="0" step="0.01" />
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-12">
                                    <button type="button" class="btn btn-primary" id="addToList">Add to List</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Added Supplies List -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h4>Added Supplies</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered" id="suppliesTable">
                                <thead>
                                    <tr>
                                        <th>Supply Name</th>
                                        <th>Quantity</th>
                                        <th>Unit Cost</th>
                                        <th>Total</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="suppliesList">
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="3" class="text-right">Grand Total:</th>
                                        <th id="grandTotal">0.00</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-12">
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary" id="submitBtn" disabled />
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            let detailCount = 0;
            let supplies = [];

            function updateGrandTotal() {
                const total = supplies.reduce((sum, item) => sum + (item.quantity * item.unitCost), 0);
                $('#grandTotal').text(total.toFixed(2));
                $('#submitBtn').prop('disabled', supplies.length === 0);
            }

            function addSupplyToTable(supply) {
                const row = `
                    <tr data-index="${detailCount}">
                        <td>${supply.supplyName}</td>
                        <td>${supply.quantity}</td>
                        <td>${supply.unitCost.toFixed(2)}</td>
                        <td>${(supply.quantity * supply.unitCost).toFixed(2)}</td>
                        <td>
                            <button type="button" class="btn btn-danger btn-sm remove-supply">Remove</button>
                        </td>
                    </tr>
                `;
                $('#suppliesList').append(row);
                updateGrandTotal();
            }

            function addHiddenInputs(supply) {
                const index = detailCount;
                const fields = [
                    { name: `SupplyInDetails[${index}].Supply.SupplierID`, value: supply.supplierId },
                    { name: `SupplyInDetails[${index}].Supply.FundClusterID`, value: supply.fundClusterId },
                    { name: `SupplyInDetails[${index}].Supply.StockPropNo`, value: supply.stockPropNo },
                    { name: `SupplyInDetails[${index}].Supply.SupplyName`, value: supply.supplyName },
                    { name: `SupplyInDetails[${index}].Supply.Description`, value: supply.description },
                    { name: `SupplyInDetails[${index}].Supply.UnitMeasurement`, value: supply.unitMeasurement },
                    { name: `SupplyInDetails[${index}].Supply.StockQuantity`, value: supply.quantity },
                    { name: `SupplyInDetails[${index}].Supply.UnitCost`, value: supply.unitCost }
                ];

                fields.forEach(field => {
                    $(`<input type="hidden" name="${field.name}" value="${field.value}">`).appendTo('#supplyForm');
                });
            }

            $('#addToList').click(function () {
                const supply = {
                    supplierId: $('#supplierSelect').val(),
                    fundClusterId: $('#fundClusterSelect').val(),
                    stockPropNo: $('#stockPropNo').val(),
                    supplyName: $('#supplyName').val(),
                    description: $('#description').val(),
                    unitMeasurement: $('#unitMeasurement').val(),
                    quantity: parseInt($('#quantity').val()),
                    unitCost: parseFloat($('#unitCost').val())
                };

                if (!supply.supplierId || !supply.fundClusterId || !supply.stockPropNo || 
                    !supply.supplyName || !supply.description || !supply.unitMeasurement || 
                    !supply.quantity || !supply.unitCost) {
                    alert('Please fill in all fields');
                    return;
                }

                supplies.push(supply);
                addSupplyToTable(supply);
                addHiddenInputs(supply);
                detailCount++;

                // Clear form
                $('#supplierSelect, #fundClusterSelect').val('');
                $('#stockPropNo, #supplyName, #description, #unitMeasurement, #quantity, #unitCost').val('');
            });

            $(document).on('click', '.remove-supply', function () {
                const index = $(this).closest('tr').data('index');
                supplies.splice(index, 1);
                $(this).closest('tr').remove();
                
                // Rebuild hidden inputs
                $('input[name^="SupplyInDetails"]').remove();
                supplies.forEach((supply, idx) => {
                    addHiddenInputs(supply);
                });
                
                updateGrandTotal();
            });

            // Prevent form submission if no supplies are added
            $('#supplyForm').submit(function(e) {
                if (supplies.length === 0) {
                    e.preventDefault();
                    alert('Please add at least one supply before submitting');
                }
            });
        });
    </script>
}
