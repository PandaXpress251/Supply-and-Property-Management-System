@model SIETE.Models.Supply.StockCard

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>StockCard</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="StockCardName" class="control-label"></label>
                <input asp-for="StockCardName" class="form-control" />
                <span asp-validation-for="StockCardName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StockDescription" class="control-label"></label>
                <input asp-for="StockDescription" class="form-control" />
                <span asp-validation-for="StockDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StockUnitMeasurement" class="control-label"></label>
                <input asp-for="StockUnitMeasurement" class="form-control" />
                <span asp-validation-for="StockUnitMeasurement" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CurrentStockQuantity" class="control-label"></label>
                <input asp-for="CurrentStockQuantity" class="form-control" />
                <span asp-validation-for="CurrentStockQuantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalAmount" class="control-label"></label>
                <input asp-for="TotalAmount" class="form-control" />
                <span asp-validation-for="TotalAmount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastUpdated" class="control-label"></label>
                <input asp-for="LastUpdated" class="form-control" />
                <span asp-validation-for="LastUpdated" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
