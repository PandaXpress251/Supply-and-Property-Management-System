@model SIETE.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="employee-details">
    <!-- Employee Header -->
    <div class="employee-header mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="employee-icon">
                <i class="fas fa-user-tie fa-2x text-primary"></i>
            </div>
            <div>
                <h4 class="mb-1">@Model.FullName</h4>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Employee Information -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Employee Information</h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <!-- Personal Info -->
               
                <!-- Contact Info -->
                <div class="col-md-6">
                    <div class="info-item">
                        <label class="text-muted small">Email Address</label>
                        <p class="mb-0"><i class="fas fa-envelope text-secondary me-2"></i>@Model.EmailAddress</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-item">
                        <label class="text-muted small">Phone Number</label>
                        <p class="mb-0"><i class="fas fa-phone text-secondary me-2"></i>@Model.PhoneNumber</p>
                    </div>
                </div>
                <!-- Position Info -->
                <div class="col-md-6">
                    <div class="info-item">
                        <label class="text-muted small">Office</label>
                        <p class="mb-0"><i class="fas fa-building text-secondary me-2"></i>@Model.Office?.OfficeName</p>
                    </div>
                </div>
               
                <div class="col-md-6">
                    <div class="info-item">
                        <label class="text-muted small">Position</label>
                        <p class="mb-0"><i class="fas fa-user-tie text-info me-2"></i>@Model.PlantillaPosition?.PositionTitle</p>
                    </div>
                </div>
               
                <!-- Accountable Person -->
                <div class="col-md-6">
                    <div class="info-item">
                        <label class="text-muted small">Is Accountable Person</label>
                        <p class="mb-0">@(Model.IsAccountablePerson ? "Yes" : "No")</p>
                    </div>
                </div>
               
            </div>
        </div>
    </div>
</div>

<style>
    .badge {
        padding: 0.5em 0.75em;
        font-weight: 500;
        border-radius: 0.5rem;
    }

    .bg-success-subtle {
        background-color: #e6f4ea;
    }

    .text-success {
        color: #137333 !important;
    }

    .bg-danger-subtle {
        background-color: #fce8e6;
    }

    .text-danger {
        color: #c5221f !important;
    }

    .card {
        border: none;
        border-radius: 0.5rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #e9ecef;
        padding: 1rem;
    }

    .card-body {
        padding: 1.5rem;
    }

    .info-item {
        margin-bottom: 1rem;
    }

    .info-item label {
        display: block;
        margin-bottom: 0.25rem;
    }

    .info-item p {
        font-weight: 500;
    }
</style>
