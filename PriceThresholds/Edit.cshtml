@model SIETE.Models.PriceThreshold

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="PropertyThreshold" class="form-label fw-semibold"></label>
        <input asp-for="PropertyThreshold" class="form-control" />
        <span asp-validation-for="PropertyThreshold" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SPThreshold" class="form-label fw-semibold"></label>
        <input asp-for="SPThreshold" class="form-control" />
        <span asp-validation-for="SPThreshold" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EffectiveDate" class="form-label fw-semibold"></label>
        <input asp-for="EffectiveDate" class="form-control" type="date" />
        <span asp-validation-for="EffectiveDate" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-end pt-2 border-top">
        <button type="submit" class="btn btn-primary">
            💾 Save Changes
        </button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
